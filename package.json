{
  "name": "symviz-crystal-symmetry-explorer",
  "version": "0.1.3",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node tools/build-symmetry-demo.mjs && vinext build",
    "symmetry:build": "node tools/build-symmetry-demo.mjs",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/disorder-analysis.test.mjs tests/structure-formats.test.mjs tests/crystal-utilities.test.mjs tests/gaussian-tools.test.mjs tests/quantum-espresso-tools.test.mjs tests/desktop-runtime.test.mjs tests/quantum-espresso-desktop.test.mjs tests/multiwfn-desktop.test.mjs tests/symmetry-catalog.test.mjs tests/symmetry-demo-desktop.test.mjs tests/symmetry-demo-host.test.mjs tests/symmetry-viewer-math.test.mjs tests/symmetry-element-diagrams.test.mjs tests/symmetry-projection-diagrams.test.mjs tests/ferro-transition.test.mjs tests/symmetry-transition-routing.test.mjs",
    "gaussian:bridge": "node tools/gaussian-bridge.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node tools/desktop-dev.mjs",
    "desktop:dir": "npm run build && electron-builder --dir",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.symviz.crystal",
    "productName": "SymVizCrystal",
    "artifactName": "SymVizCrystal-${version}-${arch}.${ext}",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
