# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.pnpm-store/
/.codex-dev*.log
*.tsbuildinfo
/outputs/
/work/
/desktop-release/
/gaussian-jobs/
/CRASH
/input_tmp.in

# local third-party scientific executables (detected at runtime, not bundled)
/Multiwfn*_bin_Win64/

# Python caches and local verification artifacts
__pycache__/
*.py[cod]
/reports/test-runs/
/reports/olex2/

# Offline International Tables extracts are not application assets
/public/symmetry-demo/international-tables/
/reports/international-table-diagrams-validation.json
